{
  "$schema": "https://docs.renovatebot.com/renovate-global-schema.json",
  "platform": "github",
  "autodiscover": true,
  "autodiscoverFilter": ["pyrlyn/*"],
  "onboarding": false,
  "requireConfig": "optional",
  "allowedUnsafeExecutions": ["mise"],
  "extends": ["local>pyrlyn/ci//renovate/mise", "local>pyrlyn/ci//renovate/deps"]
}
